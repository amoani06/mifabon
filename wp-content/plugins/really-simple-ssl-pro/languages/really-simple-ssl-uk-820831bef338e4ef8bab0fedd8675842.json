43b\u0438 \u0445\u0442\u043e\u0441\u044c \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \/wp-admin \u0430\u0431\u043e \/wp-login.php. \u0417\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 404."],"Redirecting to dashboard...":["\u041f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u044c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432..."],"Reload Captcha":["\u041f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 Captcha"],"Remove":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438"],"Reset":["\u0421\u043a\u0438\u043d\u0443\u0442\u0438"],"Restrict access from specific countries or continents. You can also allow only specific countries.":["\u041e\u0431\u043c\u0435\u0436\u0438\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0437 \u043f\u0435\u0432\u043d\u0438\u0445 \u043a\u0440\u0430\u0457\u043d \u0430\u0431\u043e \u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0442\u0456\u0432. \u0412\u0438 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u043b\u0438\u0448\u0435 \u0437 \u043f\u0435\u0432\u043d\u0438\u0445 \u043a\u0440\u0430\u0457\u043d."],"Review the settings and enforce the policy":["\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0439\u0442\u0435 \u043f\u043e\u043b\u0456\u0442\u0438\u043a\u0443"],"Revoke":["\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438"],"rows":["\u0440\u044f\u0434\u043a\u0438"],"Rows per page:":["\u0420\u044f\u0434\u043a\u0456\u0432 \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456:"],"Search":["\u041f\u043e\u0448\u0443\u043a"],"Search for a post.":["\u041f\u043e\u0448\u0443\u043a \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457."],"Selected regions are now allowed":["\u0412\u0438\u0431\u0440\u0430\u043d\u0456 \u0440\u0435\u0433\u0456\u043e\u043d\u0438 \u0442\u0435\u043f\u0435\u0440 \u0434\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u0456"],"Send":["\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438"],"Show ignored URLs":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u0456\u0433\u043d\u043e\u0440\u043e\u0432\u0430\u043d\u0456 URL-\u0430\u0434\u0440\u0435\u0441\u0438"],"Skip DNS check":["\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 DNS"],"Skip DNS verification":["\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 DNS"],"SSL activated!":["SSL \u0430\u043a\u0442\u0438\u0432\u043e\u0432\u0430\u043d\u043e!"],"SSL already activated":["SSL \u0432\u0436\u0435 \u0430\u043a\u0442\u0438\u0432\u043e\u0432\u0430\u043d\u043e"],"SSL has already been activated on your site.":["SSL \u0432\u0436\u0435 \u0430\u043a\u0442\u0438\u0432\u043e\u0432\u0430\u043d\u043e \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 \u0441\u0430\u0439\u0442\u0456."],"Start scan":["\u0420\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f"],"Stop":["\u0421\u0442\u0456\u0439"],"success":["\u0443\u0441\u043f\u0456\u0445"],"Switch to directory verification":["\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443"],"Switch to DNS verification":["\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 DNS"],"Test notifications":["\u0422\u0435\u0441\u0442\u043e\u0432\u0456 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f"],"The CA Bundle will sometimes be automatically detected. If not, you can use this file.":["\u041f\u0430\u043a\u0435\u0442 CA \u0456\u043d\u043e\u0434\u0456 \u0432\u0438\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e. \u042f\u043a\u0449\u043e \u043d\u0456, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044f \u0446\u0438\u043c \u0444\u0430\u0439\u043b\u043e\u043c."],"The certificate is not generated by Really Simple Security, so there are no installation files here":["\u0421\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442 \u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0443\u0454\u0442\u044c\u0441\u044f Really Simple Security, \u0442\u043e\u043c\u0443 \u0442\u0443\u0442 \u043d\u0435\u043c\u0430\u0454 \u0444\u0430\u0439\u043b\u0456\u0432 \u0456\u043d\u0441\u0442\u0430\u043b\u044f\u0446\u0456\u0457."],"The certificate will get stored in this directory.":["\u0421\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442 \u0431\u0443\u0434\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0432 \u0446\u044c\u043e\u043c\u0443 \u043a\u0430\u0442\u0430\u043b\u043e\u0437\u0456."],"The challenge directory is used to verify the domain ownership.":["\u041a\u0430\u0442\u0430\u043b\u043e\u0433 \u0432\u0438\u043a\u043b\u0438\u043a\u0456\u0432 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u043f\u0440\u0430\u0432\u0430 \u0432\u043b\u0430\u0441\u043d\u043e\u0441\u0442\u0456 \u043d\u0430 \u0434\u043e\u043c\u0435\u043d."],"The key directory is needed to store the generated keys.":["\u041a\u0430\u0442\u0430\u043b\u043e\u0433 \u043a\u043b\u044e\u0447\u0456\u0432 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u0434\u043b\u044f \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043d\u043d\u044f \u0437\u0433\u0435\u043d\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043b\u044e\u0447\u0456\u0432."],"The notification test only works if you save the setting first.":["\u0422\u0435\u0441\u0442 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u044c \u043f\u0440\u0430\u0446\u044e\u0454 \u043b\u0438\u0448\u0435 \u0437\u0430 \u0443\u043c\u043e\u0432\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c."],"The Permissions Policy has been disabled.":["\u041f\u043e\u043b\u0456\u0442\u0438\u043a\u0443 \u0434\u043e\u0437\u0432\u043e\u043b\u0456\u0432 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e."],"The private key can be uploaded or pasted in the appropriate field on your hosting dashboard.":["\u0417\u0430\u043a\u0440\u0438\u0442\u0438\u0439 \u043a\u043b\u044e\u0447 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0430\u0431\u043e \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0435 \u043f\u043e\u043b\u0435 \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u043e\u043c."],"This feature is only available networkwide.":["\u0426\u044f \u0444\u0443\u043d\u043a\u0446\u0456\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0442\u0456\u043b\u044c\u043a\u0438 \u0432 \u043c\u0435\u0440\u0435\u0436\u0456."],"This is the certificate, which you need to install in your hosting dashboard.":["\u0426\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442, \u044f\u043a\u0438\u0439 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0432 \u043f\u0430\u043d\u0435\u043b\u0456 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u043e\u043c."],"This will activate SSL across your entire network.":["\u0426\u0435 \u0430\u043a\u0442\u0438\u0432\u0443\u0454 SSL \u0443 \u0432\u0441\u0456\u0439 \u0432\u0430\u0448\u0456\u0439 \u043c\u0435\u0440\u0435\u0436\u0456."],"Trust IP Address":["\u0414\u043e\u0432\u0456\u0440\u0435\u043d\u0430 IP-\u0430\u0434\u0440\u0435\u0441\u0430"],"Trust Username":["\u0414\u043e\u0432\u0456\u0440\u0435\u043d\u0435 \u0456\u043c'\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430"],"Type your question here":["\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0441\u0432\u043e\u0454 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u0442\u0443\u0442"],"Update":["\u041e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f"],"URI":["\u0422\u0418\u041f"],"User-Agent":["\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0438\u0439 \u0430\u0433\u0435\u043d\u0442"],"Username":["\u0406\u043c'\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430"],"Validate CAPTCHA":["\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 CAPTCHA"],"Value":["\u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f"],"Verifying DNS records...":["\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 DNS-\u0437\u0430\u043f\u0438\u0441\u0456\u0432..."],"View":["\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438"],"Warning":["\u0423\u0412\u0410\u0413\u0410"],"We could not check the DNS records. If you just added the record, please check in a few minutes.":["\u041d\u0430\u043c \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0437\u0430\u043f\u0438\u0441\u0438 DNS. \u042f\u043a\u0449\u043e \u0432\u0438 \u0449\u043e\u0439\u043d\u043e \u0434\u043e\u0434\u0430\u043b\u0438 \u0437\u0430\u043f\u0438\u0441, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u0432\u0438\u043b\u0438\u043d."],"We finished the configuration.":["\u041c\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f."],"You can manually check the DNS records in an %sonline tool%s.":["\u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0440\u0443\u0447\u043d\u0443 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 DNS-\u0437\u0430\u043f\u0438\u0441\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e %s\u043e\u043d\u043b\u0430\u0439\u043d-\u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0443%s."],"You have enforced 2FA, but not configured any methods for the role: ":["\u0412\u0438 \u0437\u0430\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u043b\u0438 \u0434\u0432\u043e\u0444\u0430\u043a\u0442\u043e\u0440\u043d\u0443 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044e (2FA), \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043b\u0438 \u0436\u043e\u0434\u043d\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u0456\u0432 \u0434\u043b\u044f \u0440\u043e\u043b\u0456:"],"You have enforced 2FA, but not configured any methods.":["\u0412\u0438 \u0437\u0430\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u043b\u0438 \u0434\u0432\u043e\u0444\u0430\u043a\u0442\u043e\u0440\u043d\u0443 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044e (2FA), \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043b\u0438 \u0436\u043e\u0434\u043d\u0438\u0445 \u043c\u0435\u0442\u043e\u0434\u0456\u0432."],"You have not enabled email notifications in the general settings.":["\u0412\u0438 \u043d\u0435 \u0432\u0432\u0456\u043c\u043a\u043d\u0443\u043b\u0438 \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u044e \u043f\u043e\u0448\u0442\u043e\u044e \u0432 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0445 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445."],"You have selected":["\u0412\u0438 \u0432\u0438\u0431\u0440\u0430\u043b\u0438"],"You have selected %s rows":["\u0412\u0438 \u0432\u0438\u0431\u0440\u0430\u043b\u0438 %s \u0440\u044f\u0434\u043a\u0456\u0432"],"You have selected %s users":["\u0412\u0438 \u0432\u0438\u0431\u0440\u0430\u043b\u0438 %s \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432"],"Your Let's Encrypt SSL certificate has been successfully installed. Click the button below to activate SSL on your WordPress site.":["\u0412\u0430\u0448 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442 SSL Let's Encrypt \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u0430\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438 SSL \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 \u0441\u0430\u0439\u0442\u0456 WordPress."]}}}
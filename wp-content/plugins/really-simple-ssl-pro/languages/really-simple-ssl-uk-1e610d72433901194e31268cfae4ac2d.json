{"translation-revision-date":"2026-05-27 10:45+0000","generator":"WP-CLI\/2.8.1","source":"settings\/src\/LetsEncrypt\/Installation.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"uk","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10 >= 2 && n%10<=4 &&(n%100<10||n%100 >= 20)? 1 : 2);"},"Certificate (CRT)":["\u0421\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442 (CRT)"],"Certificate Authority Bundle (CABUNDLE)":["\u041f\u0430\u043a\u0435\u0442 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0456\u0432 (CABUNDLE)"],"Copied!":["\u0421\u043a\u043e\u043f\u0456\u0439\u043e\u0432\u0430\u043d\u043e!"],"Copy content":["\u041a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u0432\u043c\u0456\u0441\u0442"],"Download":["\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438"],"Install your certificate.":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442."],"Next step":["\u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u043e\u043a"],"Private Key (KEY)":["\u0417\u0430\u043a\u0440\u0438\u0442\u0438\u0439 \u043a\u043b\u044e\u0447 (KEY)"],"The CA Bundle will sometimes be automatically detected. If not, you can use this file.":["\u041f\u0430\u043a\u0435\u0442 CA \u0456\u043d\u043e\u0434\u0456 \u0432\u0438\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e. \u042f\u043a\u0449\u043e \u043d\u0456, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044f \u0446\u0438\u043c \u0444\u0430\u0439\u043b\u043e\u043c."],"The certificate is not generated by Really Simple Security, so there are no installation files here":["\u0421\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442 \u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0443\u0454\u0442\u044c\u0441\u044f Really Simple Security, \u0442\u043e\u043c\u0443 \u0442\u0443\u0442 \u043d\u0435\u043c\u0430\u0454 \u0444\u0430\u0439\u043b\u0456\u0432 \u0456\u043d\u0441\u0442\u0430\u043b\u044f\u0446\u0456\u0457."],"The private key can be uploaded or pasted in the appropriate field on your hosting dashboard.":["\u0417\u0430\u043a\u0440\u0438\u0442\u0438\u0439 \u043a\u043b\u044e\u0447 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0430\u0431\u043e \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0435 \u043f\u043e\u043b\u0435 \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u043e\u043c."],"This is the certificate, which you need to install in your hosting dashboard.":["\u0426\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442, \u044f\u043a\u0438\u0439 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0432 \u043f\u0430\u043d\u0435\u043b\u0456 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u043e\u043c."]}}}
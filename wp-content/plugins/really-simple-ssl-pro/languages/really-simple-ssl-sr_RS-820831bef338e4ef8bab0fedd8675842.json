440\u0430\u0432\u0430 \u0441\u0435 \u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043d\u0443 \u0442\u0430\u0431\u043b\u0443..."],"Reload Captcha":["\u041f\u043e\u043d\u043e\u0432\u043e \u0443\u0447\u0438\u0442\u0430\u0458 Captcha"],"Remove":["\u0423\u043a\u043b\u043e\u043d\u0438"],"Reset":["\u0420\u0435\u0441\u0435\u0442\u043e\u0432\u0430\u0442\u0438"],"Restrict access from specific countries or continents. You can also allow only specific countries.":["\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0442\u0435 \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0438\u0437 \u043e\u0434\u0440\u0435\u0452\u0435\u043d\u0438\u0445 \u0437\u0435\u043c\u0430\u0459\u0430 \u0438\u043b\u0438 \u043a\u043e\u043d\u0442\u0438\u043d\u0435\u043d\u0430\u0442\u0430. \u0422\u0430\u043a\u043e\u0452\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0441\u0430\u043c\u043e \u043e\u0434\u0440\u0435\u0452\u0435\u043d\u0435 \u0437\u0435\u043c\u0459\u0435."],"Review the settings and enforce the policy":["\u041f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u0458\u0442\u0435 \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0430 \u0438 \u0441\u043f\u0440\u043e\u0432\u0435\u0434\u0438\u0442\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0443"],"Revoke":["\u041f\u043e\u043d\u0438\u0448\u0442\u0438\u0442\u0438"],"rows":["\u0440\u0435\u0434\u043e\u0432\u0438"],"Rows per page:":["\u0420\u0435\u0434\u043e\u0432\u0430 \u043f\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0438:"],"Search":["\u041f\u0440\u0435\u0442\u0440\u0430\u0433\u0430"],"Search for a post.":["\u041f\u0440\u0435\u0442\u0440\u0430\u0433\u0430 \u043e\u0431\u0458\u0430\u0432\u0435."],"Selected regions are now allowed":["\u0421\u0430\u0434\u0430 \u0441\u0443 \u0434\u043e\u0437\u0432\u043e\u0459\u0435\u043d\u0435 \u043e\u0434\u0430\u0431\u0440\u0430\u043d\u0435 \u0440\u0435\u0433\u0438\u0458\u0435"],"Send":["\u041f\u043e\u0448\u0430\u0459\u0438"],"Show ignored URLs":["\u041f\u0440\u0438\u043a\u0430\u0436\u0438 \u0438\u0433\u043d\u043e\u0440\u0438\u0441\u0430\u043d\u0435 \u0423\u0420\u041b-\u043e\u0432\u0435"],"Skip DNS check":["\u041f\u0440\u0435\u0441\u043a\u043e\u0447\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0443 DNS-\u0430"],"Skip DNS verification":["\u041f\u0440\u0435\u0441\u043a\u043e\u0447\u0438 \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443 DNS-\u0430"],"SSL activated!":["SSL \u0458\u0435 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d!"],"SSL already activated":["SSL \u0458\u0435 \u0432\u0435\u045b \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d"],"SSL has already been activated on your site.":["SSL \u0458\u0435 \u0432\u0435\u045b \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d \u043d\u0430 \u0432\u0430\u0448\u0435\u043c \u0441\u0430\u0458\u0442\u0443."],"Start scan":["\u041f\u043e\u043a\u0440\u0435\u043d\u0438 \u0441\u043a\u0435\u043d\u0438\u0440\u0430\u045a\u0435"],"Stop":["\u0421\u0442\u043e\u043f"],"success":["\u0443\u0441\u043f\u0435\u0445"],"Switch to directory verification":["\u041f\u0440\u0435\u0452\u0438\u0442\u0435 \u043d\u0430 \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0438\u0458\u0443\u043c\u0430"],"Switch to DNS verification":["\u041f\u0440\u0435\u0452\u0438\u0442\u0435 \u043d\u0430 DNS \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443"],"Test notifications":["\u0422\u0435\u0441\u0442\u043d\u0430 \u043e\u0431\u0430\u0432\u0435\u0448\u0442\u0435\u045a\u0430"],"The CA Bundle will sometimes be automatically detected. If not, you can use this file.":["CA \u043f\u0430\u043a\u0435\u0442 \u045b\u0435 \u043f\u043e\u043d\u0435\u043a\u0430\u0434 \u0431\u0438\u0442\u0438 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u0434\u0435\u0442\u0435\u043a\u0442\u043e\u0432\u0430\u043d. \u0410\u043a\u043e \u043d\u0435, \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u043e\u0432\u0430\u0458 \u0444\u0430\u0458\u043b."],"The certificate is not generated by Really Simple Security, so there are no installation files here":["\u0421\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442 \u043d\u0438\u0458\u0435 \u0433\u0435\u043d\u0435\u0440\u0438\u0441\u0430\u043d \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 Really Simple Security, \u043f\u0430 \u043e\u0432\u0434\u0435 \u043d\u0435\u043c\u0430 \u0438\u043d\u0441\u0442\u0430\u043b\u0430\u0446\u0438\u043e\u043d\u0438\u0445 \u0434\u0430\u0442\u043e\u0442\u0435\u043a\u0430."],"The certificate will get stored in this directory.":["\u0421\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442 \u045b\u0435 \u0431\u0438\u0442\u0438 \u0441\u0430\u0447\u0443\u0432\u0430\u043d \u0443 \u043e\u0432\u043e\u043c \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0438\u0458\u0443\u043c\u0443."],"The challenge directory is used to verify the domain ownership.":["\u0414\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0438\u0458\u0443\u043c \u0438\u0437\u0430\u0437\u043e\u0432\u0430 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u0443 \u0432\u043b\u0430\u0441\u043d\u0438\u0448\u0442\u0432\u0430 \u043d\u0430\u0434 \u0434\u043e\u043c\u0435\u043d\u043e\u043c."],"The key directory is needed to store the generated keys.":["\u041a\u0459\u0443\u0447\u043d\u0438 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0438\u0458\u0443\u043c \u0458\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0430\u043d \u0437\u0430 \u0441\u043a\u043b\u0430\u0434\u0438\u0448\u0442\u0435\u045a\u0435 \u0433\u0435\u043d\u0435\u0440\u0438\u0441\u0430\u043d\u0438\u0445 \u043a\u0459\u0443\u0447\u0435\u0432\u0430."],"The notification test only works if you save the setting first.":["\u0422\u0435\u0441\u0442 \u043e\u0431\u0430\u0432\u0435\u0448\u0442\u0435\u045a\u0430 \u0440\u0430\u0434\u0438 \u0441\u0430\u043c\u043e \u0430\u043a\u043e \u043f\u0440\u0432\u043e \u0441\u0430\u0447\u0443\u0432\u0430\u0442\u0435 \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0435."],"The Permissions Policy has been disabled.":["\u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0434\u043e\u0437\u0432\u043e\u043b\u0430 \u0458\u0435 \u043e\u043d\u0435\u043c\u043e\u0433\u0443\u045b\u0435\u043d\u0430."],"The private key can be uploaded or pasted in the appropriate field on your hosting dashboard.":["\u041f\u0440\u0438\u0432\u0430\u0442\u043d\u0438 \u043a\u0459\u0443\u0447 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u043f\u0440\u0435\u043c\u0438\u0442\u0438 \u0438\u043b\u0438 \u0437\u0430\u043b\u0435\u043f\u0438\u0442\u0438 \u0443 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430\u0458\u0443\u045b\u0435 \u043f\u043e\u0459\u0435 \u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043d\u043e\u0458 \u0442\u0430\u0431\u043b\u0438 \u0432\u0430\u0448\u0435\u0433 \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u0430."],"This feature is only available networkwide.":["\u041e\u0432\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0458\u0430 \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0441\u0430\u043c\u043e \u043d\u0430 \u043d\u0438\u0432\u043e\u0443 \u0446\u0435\u043b\u0435 \u043c\u0440\u0435\u0436\u0435."],"This is the certificate, which you need to install in your hosting dashboard.":["\u041e\u0432\u043e \u0458\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442 \u043a\u043e\u0458\u0438 \u0442\u0440\u0435\u0431\u0430 \u0434\u0430 \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u0442\u0435 \u0443 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043d\u043e\u0458 \u0442\u0430\u0431\u043b\u0438 \u0441\u0432\u043e\u0433 \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u0430."],"This will activate SSL across your entire network.":["\u041e\u0432\u043e \u045b\u0435 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u0442\u0438 SSL \u043d\u0430 \u0446\u0435\u043b\u043e\u0458 \u0432\u0430\u0448\u043e\u0458 \u043c\u0440\u0435\u0436\u0438."],"Trust IP Address":["\u041f\u043e\u0432\u0435\u0440\u0459\u0438\u0432\u0430 \u0418\u041f \u0430\u0434\u0440\u0435\u0441\u0430"],"Trust Username":["\u041f\u043e\u0432\u0435\u0440\u0459\u0438\u0432\u043e \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u0447\u043a\u043e \u0438\u043c\u0435"],"Type your question here":["\u0423\u043d\u0435\u0441\u0438\u0442\u0435 \u0441\u0432\u043e\u0458\u0435 \u043f\u0438\u0442\u0430\u045a\u0435 \u043e\u0432\u0434\u0435"],"Update":["\u0410\u0436\u0443\u0440\u0438\u0440\u0430\u045a\u0435"],"URI":["\u0423\u0420\u0418"],"User-Agent":["\u041a\u043e\u0440\u0438\u0441\u043d\u0438\u0447\u043a\u0438 \u0430\u0433\u0435\u043d\u0442"],"Username":["\u041a\u043e\u0440\u0438\u0441\u043d\u0438\u0447\u043a\u043e \u0438\u043c\u0435"],"Validate CAPTCHA":["\u0412\u0430\u043b\u0438\u0434\u0438\u0440\u0430\u0458\u0442\u0435 CAPTCHA"],"Value":["\u0412\u0440\u0435\u0434\u043d\u043e\u0441\u0442"],"Verifying DNS records...":["\u041f\u0440\u043e\u0432\u0435\u0440\u0443\u0458\u0443 \u0441\u0435 \u0414\u041d\u0421 \u0437\u0430\u043f\u0438\u0441\u0438..."],"View":["\u041f\u043e\u0433\u043b\u0435\u0434\u0430\u0458\u0442\u0435"],"Warning":["\u0423\u043f\u043e\u0437\u043e\u0440\u0435\u045a\u0435"],"We could not check the DNS records. If you just added the record, please check in a few minutes.":["\u041d\u0438\u0441\u043c\u043e \u043c\u043e\u0433\u043b\u0438 \u0434\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043c\u043e DNS \u0437\u0430\u043f\u0438\u0441\u0435. \u0410\u043a\u043e \u0441\u0442\u0435 \u0443\u043f\u0440\u0430\u0432\u043e \u0434\u043e\u0434\u0430\u043b\u0438 \u0437\u0430\u043f\u0438\u0441, \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u0435 \u0437\u0430 \u043d\u0435\u043a\u043e\u043b\u0438\u043a\u043e \u043c\u0438\u043d\u0443\u0442\u0430."],"We finished the configuration.":["\u0417\u0430\u0432\u0440\u0448\u0438\u043b\u0438 \u0441\u043c\u043e \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0458\u0443."],"You can manually check the DNS records in an %sonline tool%s.":["\u041c\u043e\u0436\u0435\u0442\u0435 \u0440\u0443\u0447\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u0438 DNS \u0437\u0430\u043f\u0438\u0441\u0435 \u0443 %sonline tool%s."],"You have enforced 2FA, but not configured any methods for the role: ":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043b\u0438 \u0441\u0442\u0435 2FA, \u0430\u043b\u0438 \u043d\u0438\u0441\u0442\u0435 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0438\u0441\u0430\u043b\u0438 \u043d\u0438\u0458\u0435\u0434\u0430\u043d \u043c\u0435\u0442\u043e\u0434 \u0437\u0430 \u0443\u043b\u043e\u0433\u0443: "],"You have enforced 2FA, but not configured any methods.":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043b\u0438 \u0441\u0442\u0435 2FA, \u0430\u043b\u0438 \u043d\u0438\u0441\u0442\u0435 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0438\u0441\u0430\u043b\u0438 \u043d\u0438\u0458\u0435\u0434\u0430\u043d \u043c\u0435\u0442\u043e\u0434."],"You have not enabled email notifications in the general settings.":["\u041d\u0438\u0441\u0442\u0435 \u043e\u043c\u043e\u0433\u0443\u045b\u0438\u043b\u0438 \u043e\u0431\u0430\u0432\u0435\u0448\u0442\u0435\u045a\u0430 \u043f\u0443\u0442\u0435\u043c \u0435-\u043f\u043e\u0448\u0442\u0435 \u0443 \u043e\u043f\u0448\u0442\u0438\u043c \u043f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0438\u043c\u0430."],"You have selected":["\u0418\u0437\u0430\u0431\u0440\u0430\u043b\u0438 \u0441\u0442\u0435"],"You have selected %s rows":["\u0418\u0437\u0430\u0431\u0440\u0430\u043b\u0438 \u0441\u0442\u0435 %s \u0440\u0435\u0434\u043e\u0432\u0430"],"You have selected %s users":["\u0418\u0437\u0430\u0431\u0440\u0430\u043b\u0438 \u0441\u0442\u0435 %s \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u043a\u0430"],"Your Let's Encrypt SSL certificate has been successfully installed. Click the button below to activate SSL on your WordPress site.":["\u0412\u0430\u0448 Let's Encrypt SSL \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442 \u0458\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d. \u041a\u043b\u0438\u043a\u043d\u0438\u0442\u0435 \u043d\u0430 \u0434\u0443\u0433\u043c\u0435 \u0438\u0441\u043f\u043e\u0434 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043b\u0438 SSL \u043d\u0430 \u0432\u0430\u0448\u0435\u043c WordPress \u0441\u0430\u0458\u0442\u0443."]}}}